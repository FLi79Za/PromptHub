{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["checked_at", "model", "mode", "development", "prompting_impact", "hardware_impact_16gb", "source_type", "source_url", "skill_target", "confidence"],
  "properties": {
    "checked_at": {"type": "string"},
    "model": {"type": "string", "minLength": 1},
    "mode": {"type": "array", "minItems": 1, "items": {"enum": ["t2i", "i2i", "edit", "inpaint", "composite", "text", "reference"]}},
    "development": {"type": "string", "minLength": 1},
    "prompting_impact": {"type": "string", "minLength": 1},
    "hardware_impact_16gb": {"enum": ["official", "community-tested", "unknown", "not-applicable"]},
    "source_type": {"enum": ["official-docs", "official-repository", "official-model-card", "community-evidence", "user-supplied-contract"]},
    "source_url": {"type": "string", "pattern": "^https://"},
    "skill_target": {"type": "string", "minLength": 1},
    "confidence": {"enum": ["high", "medium", "provisional"]}
  },
  "additionalProperties": false
}
